{
  "name": "@acp/dsh-tui-bridge",
  "version": "0.1.0",
  "description": "Projects the DSH client face onto the dsh-tui protocol over stdio.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./protocol": "./lib/protocol.js",
    "./runner": "./lib/runner.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stub": "node dev-stub.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-remotes": "link:../../deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-client-connection": "link:../../deepseek-harness/packages/client/connection"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "dshTui": {
    "comment": "Dependencies link a local harness checkout: dsh-api-session-controller is unpublished and the published client-face packages trail the checkout. Pin the commit below when upgrading.",
    "harnessCommit": "ddefc45fbc7f8e46dd73185e68295696d1297887"
  },
  "bin": {
    "dsh-tui-bridge": "./lib/runner.js"
  }
}
